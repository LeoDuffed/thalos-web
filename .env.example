# Configuración pública de la aplicación web de Firebase.
# Copia este archivo a .env.local y completa los valores desde Firebase.
# Los valores VITE_ son visibles en el navegador: no pongas contraseñas aquí.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_TELEMETRY_DEVICE_ID=robot-01
